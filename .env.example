# docker compose / 로컬 실행에 필요한 환경 변수 목록.
# 실제 값은 .env 에 두고, .env 는 절대 커밋하지 않는다.

# PostgreSQL
DB_NAME=careercompass
DB_USER=careercompass
DB_PASSWORD=careercompass

# 앱이 DB 에 붙을 때 쓰는 값 (compose 가 자동 주입, 직접 실행 시에만 지정)
# DB_URL=jdbc:postgresql://localhost:5432/careercompass

# JWT 서명 키 (M1 인증) — 256bit 이상 랜덤 문자열
# JWT_SECRET=

# 소셜 로그인 (M1)
# KAKAO_CLIENT_ID=
# GOOGLE_CLIENT_ID=

# FCM 서비스 계정 (M8 알림)
# FCM_CREDENTIALS_PATH=
